{
  "name": "classic-sorting",
  "version": "0.0.4",
  "description": "Top ten classical sorting algorithms",
  "type": "module",
  "main": "./dist/sort.cjs",
  "types": "./dist/sort.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sort.d.ts",
      "import": "./dist/sort.js",
      "require": "./dist/sort.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "vitest",
    "lint": "eslint --fix src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "sort"
  ],
  "author": "junhao",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
